 function submit(raw,s){if(s.mode!=='shore')return result(s,false,'배가 굽은 수로를 지나 목소리가 닿지 않는다. 출발자리로 돌아오면 부탁을 바꿀 수 있다.');const t=node(raw);if(t.word==='거울'&&t.children.length===1&&t.children[0].word==='돌리다'&&t.children[0].children.length===1&&['안','밖'].includes(t.children[0].children[0].word)){const n=copy(s);n.mirror=t.children[0].children[0].word==='밖'?'outside':'inside';return inspect(n,'mirror');}const p=parsePolicy(t);if(!p.ok)return result(s,false,p.message);const n=copy(s);n.policy=p.tree;const reading=policyReading(n);n.observations=reading.readings;const unknown=reading.readings.filter(r=>r.value===null);return result(n,true,unknown.length?'부탁은 기억했다. “하지만 지금 '+unknown.map(r=>r.label).join(' · ')+'는 확인할 수 없어. 보이지 않는 것을 맞다고 여기고 열지는 않을게.”':'수문지기가 새 부탁을 읽고 고개를 끄덕인다. “네가 배에 타면 이 상태를 계속 보고 문을 붙들게.”',{speech:[p.tree]});}
